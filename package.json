{
  "name": "harmonic-compass",
  "version": "1.0.0",
  "private": true,
  "description": "A real-time harmonic navigation and songwriting workspace for guitarists.",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/build-audio-runtimes.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "demo:video": "playwright test tests/e2e/showcase.spec.ts --config=playwright.showcase.config.ts --project=showcase-video --grep \"complete showcase\"",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "latest",
    "@fontsource/ibm-plex-mono": "latest",
    "clsx": "latest",
    "dexie": "latest",
    "fflate": "latest",
    "fft.js": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "openai": "latest",
    "react": "latest",
    "react-dom": "latest",
    "serwist": "latest",
    "tailwind-merge": "latest",
    "tone": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@serwist/turbopack": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "latest",
    "esbuild": "latest",
    "eslint": "9.39.2",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "tailwindcss": "latest",
    "typescript": "5.9.3",
    "vitest": "latest"
  }
}
